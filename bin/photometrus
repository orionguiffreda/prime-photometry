#!/usr/bin/env python
import sys
from photomitrus.photometry import photometry
from photomitrus.photometry import multi_photom
from photomitrus.photometry import ellipticity_logger
from photomitrus import multi_master
from photomitrus import master
from photomitrus import multi_combo
from photomitrus import super_master
from photomitrus import archive_reducer
from photomitrus.preprocess import astromangle_new
from photomitrus.preprocess import astromangle_wcs
from photomitrus.preprocess import gen_astrometry
from photomitrus.astrom import astrom_shift_new
from photomitrus.astrom import astrometry
from photomitrus.preprocess import flatfield
from photomitrus.preprocess import gen_flat
from photomitrus.preprocess import auto_flat
from photomitrus.sky import gen_sky
from photomitrus.sky import sky_sub
from photomitrus.stack import stack
from photomitrus import tds_reducer

if len(sys.argv) < 2:
    print('Welcome to Photometrus, the PRIME processing and photometric pipeline!\n'
          'Use "-h" to view options')

elif len(sys.argv) >= 2:
    if sys.argv[1] == 'full':
        multi_combo.main()
    elif sys.argv[1] == 'single_photometry':
        photometry.main()
    elif sys.argv[1] == 'photometry':
        multi_photom.main()
    elif sys.argv[1] == 'pipeline':
        multi_master.main()
    elif sys.argv[1] == 'stack':
        master.main()
    elif sys.argv[1] == 'tds':
        tds_reducer.main()
    elif sys.argv[1] == 'supermaster':
        super_master.main()
    elif sys.argv[1] == 'archive':
        archive_reducer.main()

    elif sys.argv[1] == '-h':
        print('Options:\n'
              '     full - to run the full pipeline & photometry\n'
              '     pipeline - to run the full pipeline (data download, processing, & stacking) on whole observation\n'
              '     stack - to specifically use the processing & stacking (no direct download, but offers more'
              ' processing options)\n'
              '     photometry - to run photometry on multiple stacked images in a directory\n'
              '     single_photometry - to run photometry on a single specific stacked image\n'
              '     astrom - to access all the separate astrometry scripts\n'
              '     process - to access all the separate processing & stack scripts\n'
              '     utilities - to access other scripts, usually analysis-based\n'
              '     tds - to mass process all fields over a night specified by csv (developed for time domain survey)\n'
              '     supermaster - mass processes all fields in latest or specified date, for use w/ automation\n'
              '     archive - to process archive images for a list of targets\n'
              )

    elif sys.argv[1] == 'astrom':
        if sys.argv[2] == '-h':
            print(
                'Astrometry script options:\n'
                '   angle - astromangle_new.py (initial rough astrometry)\n'
                '   shift - astrom_shift.py (astrometric translation correction)\n'
                '   astromatic - astrometry.py (astromatic suite programs: sextractor & scamp)\n'
                '   net - gen_astrometry.py (astrometry.net)\n'
            )
        elif sys.argv[2] == 'angle':
            # astromangle_new.main()
            astromangle_wcs.main()
        elif sys.argv[2] == 'shift':
            astrom_shift_new.main()
        elif sys.argv[2] == 'astromatic':
            astrometry.main()
        elif sys.argv[2] == 'net':
            gen_astrometry.main()

    elif sys.argv[1] == 'process':
        if sys.argv[2] == '-h':
            print(
                'Processing script options:\n'
                '   genflat - gen_flat.py (flat generation)\n'
                '   autoflat - auto_flat.py (gens mflats for whole obs)\n'
                '   flatfield - flatfield.py (cropping & flat fielding of imgs)\n'
                '   gensky - gen_sky.py (sky image generation)\n'
                '   skysub - sky_sub.py (sky subtraction of imgs)\n'
                '   stack - stack.py (swarp stacking of imgs)\n'
            )
        elif sys.argv[2] == 'autoflat':
            auto_flat.main()
        elif sys.argv[2] == 'genflat':
            gen_flat.main()
        elif sys.argv[2] == 'flatfield':
            flatfield.main()
        elif sys.argv[2] == 'gensky':
            gen_sky.main()
        elif sys.argv[2] == 'skysub':
            sky_sub.main()
        elif sys.argv[2] == 'stack':
            stack.main()

    elif sys.argv[1] == 'utilities':
        if sys.argv[2] == '-h':
            print(
                'Utilities script options:\n'
                '   logger - ellipticity_logger.py (generates csvs and 3d plots of ellipticity & psf size across all'
                ' chips for an observations stacked images)\n'
            )
        elif sys.argv[2] == 'logger':
            ellipticity_logger.main()

    else:
        print('Use only designated commands!, see "-h"')
